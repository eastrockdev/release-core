<section
  class="rc-artist-profile"
  data-rc-artist-profile
  data-appearance="{{ block.settings.appearance | default: 'reactive' }}"
  data-design-mode="{{ request.design_mode }}"
  data-endpoint="{{ routes.root_url }}apps/releasecore/portal/profile"
  data-saved-message="{{ 'releasecore.artist_profile.saved' | t | escape }}"
  data-image-saved-message="{{ 'releasecore.artist_profile.image_saved' | t | escape }}"
  data-error-message="{{ 'releasecore.artist_profile.error' | t | escape }}"
  data-no-profile-message="{{ 'releasecore.artist_profile.no_profile' | t | escape }}"
  data-saving-message="{{ 'releasecore.artist_profile.saving' | t | escape }}"
  data-uploading-message="{{ 'releasecore.artist_profile.uploading' | t | escape }}"
  data-complete-suffix="{{ 'releasecore.artist_profile.complete_suffix' | t | escape }}"
  style="--rcp-accent: {{ block.settings.accent_color | default: '#8f7cff' }};"
  {{ block.shopify_attributes }}
>
  <div class="rc-artist-profile__shell">
    <header class="rc-artist-profile__hero">
      <div class="rc-artist-profile__hero-glow" aria-hidden="true"></div>
      <div class="rc-artist-profile__hero-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M9 18V5l10-2v13M9 9l10-2M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="rc-artist-profile__hero-copy">
        <span class="rc-artist-profile__eyebrow">{{ 'releasecore.artist_profile.workspace' | t }}</span>
        <h2>{{ block.settings.heading | escape }}</h2>
        <p>{{ block.settings.description | escape }}</p>
      </div>
      {% if customer or request.design_mode %}
        <span class="rc-artist-profile__completion" data-profile-completion {% unless request.design_mode %}hidden{% endunless %}>{% if request.design_mode %}43% {{ 'releasecore.artist_profile.complete_suffix' | t }}{% endif %}</span>
      {% endif %}
    </header>

    {% if customer or request.design_mode %}
      <div class="rc-artist-profile__notice" data-profile-status role="status" aria-live="polite" {% if request.design_mode %}hidden{% endif %}>
        {{ 'releasecore.artist_profile.loading' | t }}
      </div>

      <form class="rc-artist-profile__form" data-profile-form {% unless request.design_mode %}hidden{% endunless %}>
        <label class="rc-artist-profile__switcher" data-artist-picker hidden>
          <span>
            <strong>{{ 'releasecore.artist_profile.choose_artist' | t }}</strong>
            <small>{{ 'releasecore.artist_profile.choose_artist_help' | t }}</small>
          </span>
          <select data-profile-select aria-label="{{ 'releasecore.artist_profile.choose_artist' | t | escape }}"></select>
        </label>

        <input type="hidden" name="artistId">

        <div class="rc-artist-profile__layout">
          <aside class="rc-artist-profile__sidebar">
            <article class="rc-artist-profile__card rc-artist-profile__identity-card">
              <div class="rc-artist-profile__avatar" data-profile-avatar aria-hidden="true">A</div>
              <span class="rc-artist-profile__eyebrow">{{ 'releasecore.artist_profile.public_identity' | t }}</span>
              <h3 data-profile-name>{% if request.design_mode %}Artist name{% else %}{{ 'releasecore.artist_profile.artist_fallback' | t }}{% endif %}</h3>
              <p data-profile-summary data-fallback="{{ 'releasecore.artist_profile.profile_summary' | t | escape }}">{{ 'releasecore.artist_profile.profile_summary' | t }}</p>
              <label class="rc-artist-profile__button rc-artist-profile__button--secondary">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 16V4m0 0L7 9m5-5 5 5M5 14v5h14v-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span data-profile-upload-label>{{ 'releasecore.artist_profile.upload_photo' | t }}</span>
                <input type="file" accept="image/jpeg,image/png,image/webp" data-profile-image hidden>
              </label>
              <small class="rc-artist-profile__photo-help">{{ 'releasecore.artist_profile.photo_help' | t }}</small>
            </article>

            <article class="rc-artist-profile__card rc-artist-profile__progress-card">
              <div class="rc-artist-profile__card-heading">
                <span class="rc-artist-profile__card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <h3>{{ 'releasecore.artist_profile.profile_strength' | t }}</h3>
                  <p>{{ 'releasecore.artist_profile.profile_strength_help' | t }}</p>
                </div>
              </div>
              <div class="rc-artist-profile__progress" aria-hidden="true"><span data-profile-progress {% if request.design_mode %}style="width: 43%;"{% endif %}></span></div>
              <strong class="rc-artist-profile__progress-label" data-profile-progress-label>{% if request.design_mode %}43% {{ 'releasecore.artist_profile.complete_suffix' | t }}{% endif %}</strong>
            </article>
          </aside>

          <div class="rc-artist-profile__main">
            <article class="rc-artist-profile__card">
              <div class="rc-artist-profile__card-heading">
                <span class="rc-artist-profile__card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  </svg>
                </span>
                <div>
                  <h3>{{ 'releasecore.artist_profile.identity_rights' | t }}</h3>
                  <p>{{ 'releasecore.artist_profile.identity_rights_help' | t }}</p>
                </div>
              </div>
              <div class="rc-artist-profile__grid">
                <label class="rc-artist-profile__field">
                  <span>{{ 'releasecore.artist_profile.stage_name' | t }}</span>
                  <input name="name" required readonly data-profile-name-input aria-describedby="rc-artist-name-lock-{{ block.id }}" value="{% if request.design_mode %}Artist name{% endif %}">
                  <small class="rc-artist-profile__field-help" id="rc-artist-name-lock-{{ block.id }}" data-profile-name-lock>{{ 'releasecore.artist_profile.name_locked_help' | t }}</small>
                </label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.legal_name' | t }}</span><input name="legalName"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.email' | t }}</span><input name="email" type="email"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.pro' | t }}</span><input name="pro"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.ipi' | t }}</span><input name="ipi" inputmode="numeric"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.website' | t }}</span><input name="websiteUrl" type="url" placeholder="https://"></label>
              </div>
            </article>

            <article class="rc-artist-profile__card">
              <div class="rc-artist-profile__card-heading">
                <span class="rc-artist-profile__card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 4h14v16H5V4Zm3 4h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <h3>{{ 'releasecore.artist_profile.biography' | t }}</h3>
                  <p>{{ 'releasecore.artist_profile.biography_help' | t }}</p>
                </div>
              </div>
              <label class="rc-artist-profile__field rc-artist-profile__field--visually-labeled">
                <span>{{ 'releasecore.artist_profile.biography' | t }}</span>
                <textarea name="biography" rows="7" placeholder="{{ 'releasecore.artist_profile.biography_placeholder' | t | escape }}">{% if request.design_mode %}A public-facing artist biography will appear here as the profile is completed.{% endif %}</textarea>
              </label>
            </article>

            <article class="rc-artist-profile__card">
              <div class="rc-artist-profile__card-heading">
                <span class="rc-artist-profile__card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 12a8 8 0 1 0 16 0 8 8 0 0 0-16 0Zm0 0h16M12 4a13 13 0 0 1 0 16M12 4a13 13 0 0 0 0 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </span>
                <div>
                  <h3>{{ 'releasecore.artist_profile.music_platforms' | t }}</h3>
                  <p>{{ 'releasecore.artist_profile.music_platforms_help' | t }}</p>
                </div>
              </div>
              <div class="rc-artist-profile__grid">
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.spotify' | t }}</span><input name="spotifyUrl" type="url" placeholder="https://open.spotify.com/artist/"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.apple_music' | t }}</span><input name="appleMusicUrl" type="url" placeholder="https://music.apple.com/artist/"></label>
              </div>
            </article>

            <article class="rc-artist-profile__card">
              <div class="rc-artist-profile__card-heading">
                <span class="rc-artist-profile__card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M8 12a4 4 0 0 1 4-4h3m1-3 3 3-3 3M16 12a4 4 0 0 1-4 4H9m-1 3-3-3 3-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div>
                  <h3>{{ 'releasecore.artist_profile.social_presence' | t }}</h3>
                  <p>{{ 'releasecore.artist_profile.social_presence_help' | t }}</p>
                </div>
              </div>
              <div class="rc-artist-profile__grid">
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.instagram' | t }}</span><input name="instagramUrl" type="url" placeholder="https://instagram.com/"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.facebook' | t }}</span><input name="facebookUrl" type="url" placeholder="https://facebook.com/"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.tiktok' | t }}</span><input name="tiktokUrl" type="url" placeholder="https://tiktok.com/@"></label>
                <label class="rc-artist-profile__field"><span>{{ 'releasecore.artist_profile.youtube' | t }}</span><input name="youtubeUrl" type="url" placeholder="https://youtube.com/@"></label>
                <label class="rc-artist-profile__field rc-artist-profile__field--wide"><span>{{ 'releasecore.artist_profile.x_twitter' | t }}</span><input name="xUrl" type="url" placeholder="https://x.com/"></label>
              </div>
            </article>
          </div>
        </div>

        <div class="rc-artist-profile__actions">
          <div>
            <strong>{{ 'releasecore.artist_profile.ready_title' | t }}</strong>
            <span>{{ 'releasecore.artist_profile.ready_help' | t }}</span>
          </div>
          <button class="rc-artist-profile__button" type="submit">{{ 'releasecore.artist_profile.save' | t }}</button>
        </div>
      </form>
    {% else %}
      <div class="rc-artist-profile__signin">
        <span class="rc-artist-profile__card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M8 11V8a4 4 0 1 1 8 0v3M6 11h12v10H6V11Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <div>
          <h3>{{ 'releasecore.artist_profile.sign_in_title' | t }}</h3>
          <p>{{ 'releasecore.artist_profile.sign_in_message' | t }}</p>
        </div>
        <a class="rc-artist-profile__button" href="{{ routes.account_login_url }}">{{ 'releasecore.artist_profile.sign_in' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:releasecore.artist_profile.name",
  "target": "section",
  "stylesheet": "releasecore-artist-profile.css",
  "javascript": "releasecore-artist-profile.js",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:releasecore.artist_profile.heading_label", "default": "Artist profile" },
    { "type": "textarea", "id": "description", "label": "t:releasecore.artist_profile.description_label", "default": "Manage the identity, rights information, biography, and destinations connected to your music." },
    { "type": "select", "id": "appearance", "label": "t:releasecore.artist_profile.appearance_label", "default": "reactive", "options": [
      { "value": "reactive", "label": "t:releasecore.artist_profile.appearance_reactive" },
      { "value": "dark", "label": "t:releasecore.artist_profile.appearance_dark" },
      { "value": "light", "label": "t:releasecore.artist_profile.appearance_light" }
    ]},
    { "type": "color", "id": "accent_color", "label": "t:releasecore.artist_profile.accent_label", "default": "#8f7cff" }
  ]
}
{% endschema %}
