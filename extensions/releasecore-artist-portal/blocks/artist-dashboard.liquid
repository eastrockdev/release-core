{% liquid
  assign rc_design_mode = request.design_mode
  assign rc_logged_in = false
  if customer
    assign rc_logged_in = true
  endif
%}

<style>
  [data-rc-artist-dashboard] .rc-app-sidebar__panel > .rc-app-nav,
  [data-rc-artist-dashboard] .rc-app-sidebar__panel > .rc-app-menu-group {
    margin-top: 6px;
  }

  [data-rc-artist-dashboard] .rc-app-sidebar__label + .rc-app-nav,
  [data-rc-artist-dashboard] .rc-app-sidebar__label + .rc-app-menu-group {
    margin-top: 0;
  }

  [data-rc-artist-dashboard] .rc-app-nav__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<section
  class="rc-app-dashboard"
  data-rc-artist-dashboard
  data-logged-in="{% if rc_logged_in %}true{% else %}false{% endif %}"
  data-design-mode="{% if rc_design_mode %}true{% else %}false{% endif %}"
  data-proxy-base="{{ block.settings.proxy_path | default: '/apps/releasecore' | escape }}"
  data-login-url="{{ routes.account_login_url }}"
  data-show-publisher="{% if block.settings.show_publisher %}true{% else %}false{% endif %}"
  data-show-publisher-ipi="{% if block.settings.show_publisher_ipi %}true{% else %}false{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if customer or rc_design_mode %}
    <div class="rc-app-dashboard__status" data-rc-app-status role="status" aria-live="polite">Loading your artist workspace…</div>

    <div class="rc-app-dashboard__shell">
      <div class="rc-app-membership-gate" data-rc-membership-gate hidden>
        <span class="rc-app-eyebrow">Account access</span>
        <h2>Your RLIAB access is being checked.</h2>
        <p data-rc-membership-message>If you just subscribed, Shopify Flow may still be applying your membership tag.</p>
        <button type="button" class="rc-app-primary" data-action="retry-membership">Check access again</button>
      </div>

      <div data-rc-dashboard-main>
        <header class="rc-app-identity" aria-label="Artist account information">
          <div class="rc-app-identity__artist">
            <span class="rc-app-identity__avatar" data-rc-identity-avatar>A</span>
            <div class="rc-app-identity__artist-copy">
              <span class="rc-app-identity__eyebrow">Artist workspace</span>
              <strong data-rc-identity-name>Loading artist…</strong>
              {% if block.settings.show_membership %}
                <small><span data-rc-membership-label>Membership</span></small>
              {% endif %}
              <label class="rc-app-identity__picker-wrap" data-rc-identity-picker-wrap hidden>
                <span class="rc-app-identity__eyebrow">Switch artist</span>
                <select class="rc-app-identity__picker" data-rc-identity-picker aria-label="Switch artist"></select>
              </label>
            </div>
          </div>

          <div class="rc-app-identity__meta">
            {% if block.settings.show_legal_name %}
              <div class="rc-app-identity__datum">
                <span class="rc-app-identity__eyebrow">Legal name</span>
                <strong data-rc-identity-legal>—</strong>
              </div>
            {% endif %}
            {% if block.settings.show_pro %}
              <div class="rc-app-identity__datum">
                <span class="rc-app-identity__eyebrow">PRO</span>
                <strong data-rc-identity-pro>—</strong>
              </div>
            {% endif %}
            {% if block.settings.show_ipi %}
              <div class="rc-app-identity__datum">
                <span class="rc-app-identity__eyebrow">IPI / CAE</span>
                <strong data-rc-identity-ipi>—</strong>
              </div>
            {% endif %}
            {% if block.settings.show_publisher %}
              <div class="rc-app-identity__datum">
                <span class="rc-app-identity__eyebrow">Publisher</span>
                <strong data-rc-identity-publisher>—</strong>
              </div>
            {% endif %}
            {% if block.settings.show_publisher_ipi %}
              <div class="rc-app-identity__datum">
                <span class="rc-app-identity__eyebrow">Publisher IPI</span>
                <strong data-rc-identity-publisher-ipi>—</strong>
              </div>
            {% endif %}
            {% if block.settings.show_account_status %}
              <div class="rc-app-identity__datum rc-app-identity__active" data-membership>
                <span class="rc-app-identity__eyebrow">Account</span>
                <strong data-rc-account-status>Active</strong>
              </div>
            {% endif %}
          </div>
        </header>

        <div class="rc-app-dashboard__layout">
          <aside class="rc-app-sidebar" aria-label="Artist workspace navigation">
            <div class="rc-app-sidebar__panel">
              <span class="rc-app-sidebar__label">ReleaseCore</span>

              <button type="button" class="rc-app-nav" data-rc-nav="dashboard" data-active="true">
                <span class="rc-app-nav__icon">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="4" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="14" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="14" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/></svg>
                </span>
                <span class="rc-app-nav__copy"><strong>Dashboard</strong><small>Overview</small></span>
              </button>

              <button type="button" class="rc-app-nav" data-rc-nav="releases">
                <span class="rc-app-nav__icon">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18V5l10-2v13M9 9l10-2M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="rc-app-nav__copy"><strong>My Releases</strong><small>Catalog & distribution</small></span>
              </button>

              <button type="button" class="rc-app-nav rc-app-nav--primary" data-action="new-release">
                <span class="rc-app-nav__icon">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
                </span>
                <span class="rc-app-nav__copy"><strong>New Release</strong><small>Start a draft</small></span>
              </button>

              <button type="button" class="rc-app-nav" data-rc-nav="profile">
                <span class="rc-app-nav__icon">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </span>
                <span class="rc-app-nav__copy"><strong>Artist Profile</strong><small>Identity & rights</small></span>
              </button>

              <button type="button" class="rc-app-nav" data-rc-nav="contributors">
                <span class="rc-app-nav__icon">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 2a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 20a5 5 0 0 1 10 0m0 0a5 5 0 0 1 8 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </span>
                <span class="rc-app-nav__copy"><strong>Contributors</strong><small>Linked credits</small></span>
              </button>
            </div>

            {% if block.settings.supplemental_menu != blank %}
              <div class="rc-app-sidebar__panel">
                <span class="rc-app-sidebar__label">{{ block.settings.supplemental_heading | default: 'East Rock' | escape }}</span>
                {% for link in block.settings.supplemental_menu.links %}
                  {% if link.links != blank %}
                    <details class="rc-app-menu-group">
                      <summary class="rc-app-nav">
                        <span class="rc-app-nav__icon" aria-hidden="true">
                          {% render 'releasecore-menu-icon', title: link.title, auto_match: block.settings.supplemental_auto_icons, fallback: block.settings.supplemental_fallback_icon %}
                        </span>
                        <span class="rc-app-nav__copy"><strong>{{ link.title | escape }}</strong></span>
                        <svg class="rc-app-menu-group__chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </summary>
                      <div class="rc-app-menu-children">
                        {% if link.url != blank and link.url != '#' %}
                          <a class="rc-app-nav rc-app-menu-overview" href="{{ link.url }}">
                            <span class="rc-app-nav__copy"><strong>Open {{ link.title | escape }}</strong></span>
                          </a>
                        {% endif %}
                        {% for child in link.links %}
                          {% if child.links != blank %}
                            <details class="rc-app-menu-group">
                              <summary class="rc-app-nav">
                                <span class="rc-app-nav__copy"><strong>{{ child.title | escape }}</strong></span>
                                <svg class="rc-app-menu-group__chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              </summary>
                              <div class="rc-app-menu-children rc-app-menu-children--level-3">
                                {% if child.url != blank and child.url != '#' %}
                                  <a class="rc-app-nav rc-app-menu-overview" href="{{ child.url }}">
                                    <span class="rc-app-nav__copy"><strong>Open {{ child.title | escape }}</strong></span>
                                  </a>
                                {% endif %}
                                {% for grandchild in child.links %}
                                  <a class="rc-app-nav" href="{{ grandchild.url }}">
                                    <span class="rc-app-nav__copy"><strong>{{ grandchild.title | escape }}</strong></span>
                                  </a>
                                {% endfor %}
                              </div>
                            </details>
                          {% else %}
                            <a class="rc-app-nav" href="{{ child.url }}">
                              <span class="rc-app-nav__copy"><strong>{{ child.title | escape }}</strong></span>
                            </a>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </details>
                  {% else %}
                    <a class="rc-app-nav" href="{{ link.url }}">
                      <span class="rc-app-nav__icon" aria-hidden="true">
                        {% render 'releasecore-menu-icon', title: link.title, auto_match: block.settings.supplemental_auto_icons, fallback: block.settings.supplemental_fallback_icon %}
                      </span>
                      <span class="rc-app-nav__copy"><strong>{{ link.title | escape }}</strong></span>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </aside>

          <main class="rc-app-main" data-rc-dashboard-scroll>
            <section class="rc-app-view" data-rc-view="dashboard">
              <div class="rc-app-onboarding" data-rc-onboarding hidden>
                <div class="rc-app-onboarding__head">
                  <span class="rc-app-eyebrow">Finish account setup</span>
                  <h2>Create your ReleaseCore artist profile.</h2>
                  <p>Your Shopify account has RLIAB access, but it is not associated with an artist yet. Review the information below and save it once. From that point forward, ReleaseCore becomes the source of truth for your artist identity and releases.</p>
                </div>

                <div class="rc-app-onboarding__legacy" data-rc-legacy-prefill hidden>
                  We found artist information on your existing Shopify customer profile and used it to prefill this form. Nothing is written back to those legacy customer metafields.
                </div>

                <form class="rc-app-onboarding__form" data-rc-onboarding-form>
                  <label class="rc-app-field">
                    <span>Artist / stage name *</span>
                    <input name="name" required autocomplete="organization-title">
                  </label>
                  <label class="rc-app-field">
                    <span>Legal name</span>
                    <input name="legalName" autocomplete="name">
                  </label>
                  <label class="rc-app-field">
                    <span>Contact email</span>
                    <input name="email" type="email" autocomplete="email">
                  </label>
                  <label class="rc-app-field">
                    <span>Performance rights organization (PRO)</span>
                    <input name="pro" placeholder="BMI, ASCAP, SESAC…">
                  </label>
                  <label class="rc-app-field">
                    <span>IPI / CAE</span>
                    <input name="ipi" inputmode="numeric">
                  </label>
                  {% if block.settings.show_publisher %}
                    <label class="rc-app-field">
                      <span>Publisher</span>
                      <input name="publisherName">
                    </label>
                  {% else %}
                    <input type="hidden" name="publisherName">
                  {% endif %}
                  {% if block.settings.show_publisher_ipi %}
                    <label class="rc-app-field">
                      <span>Publisher IPI</span>
                      <input name="publisherIpi" inputmode="numeric">
                    </label>
                  {% else %}
                    <input type="hidden" name="publisherIpi">
                  {% endif %}
                  <label class="rc-app-field">
                    <span>Website</span>
                    <input name="websiteUrl" type="url" placeholder="https://">
                  </label>
                  <label class="rc-app-field">
                    <span>Spotify artist URL</span>
                    <input name="spotifyUrl" type="url" placeholder="https://open.spotify.com/artist/">
                  </label>
                  <label class="rc-app-field">
                    <span>Apple Music artist URL</span>
                    <input name="appleMusicUrl" type="url" placeholder="https://music.apple.com/artist/">
                  </label>
                  <div class="rc-app-onboarding__actions">
                    <span class="rc-app-form-message" data-rc-onboarding-message hidden role="status" aria-live="polite"></span>
                    <button type="submit" class="rc-app-primary">Save artist & open dashboard</button>
                  </div>
                </form>
              </div>

              <div class="rc-app-page-head">
                <div>
                  <span class="rc-app-eyebrow">ReleaseCore artist portal</span>
                  <h1>Dashboard</h1>
                  <p>Your music, artist identity and distribution activity in one workspace.</p>
                </div>
                <button type="button" class="rc-app-primary" data-action="new-release">+ New release</button>
              </div>

              <div class="rc-app-stats">
                <article class="rc-app-stat"><span>Releases</span><strong data-stat="total">0</strong></article>
                <article class="rc-app-stat"><span>Active</span><strong data-stat="active">0</strong></article>
                <article class="rc-app-stat"><span>Upcoming</span><strong data-stat="upcoming">0</strong></article>
                <article class="rc-app-stat"><span>Needs attention</span><strong data-stat="attention">0</strong></article>
                <article class="rc-app-stat"><span>Live</span><strong data-stat="live">0</strong></article>
              </div>

              <div class="rc-app-dashboard-grid">
                <article class="rc-app-card">
                  <div class="rc-app-card__head">
                    <div>
                      <h2>Recent releases</h2>
                      <p>Your latest ReleaseCore projects.</p>
                    </div>
                    <button type="button" data-rc-nav="releases">View all →</button>
                  </div>
                  <div class="rc-app-release-list" data-rc-recent-releases></div>
                </article>

                <div style="display:grid;gap:14px;align-content:start;">
                  <article class="rc-app-card">
                    <div class="rc-app-profile-health">
                      <div class="rc-app-profile-health__top">
                        <strong>Artist profile</strong>
                        <span data-rc-profile-percent>0%</span>
                      </div>
                      <div class="rc-app-progress"><span data-rc-profile-progress></span></div>
                      <p data-rc-profile-missing>Checking your artist information…</p>
                      <button type="button" class="rc-app-secondary" data-action="open-profile">Review artist profile</button>
                    </div>
                  </article>

                  <article class="rc-app-card">
                    <div class="rc-app-card__head"><div><h2>Quick actions</h2><p>Common ReleaseCore tasks.</p></div></div>
                    <div class="rc-app-quick">
                      <button type="button" data-action="new-release"><span><strong>Create a release</strong><span>Single, EP or album</span></span></button>
                      <button type="button" data-rc-nav="profile"><span><strong>Edit artist profile</strong><span>Rights, publisher and destinations</span></span></button>
                      <button type="button" data-rc-nav="contributors"><span><strong>View contributors</strong><span>Reusable linked identities</span></span></button>
                    </div>
                  </article>
                </div>
              </div>
            </section>

            <section class="rc-app-view" data-rc-view="releases" hidden>
              <div class="rc-app-page-head">
                <div>
                  <span class="rc-app-eyebrow">ReleaseCore catalog</span>
                  <h1>My Releases</h1>
                  <p>Everything for the selected artist, in one ReleaseCore workspace.</p>
                </div>
                <button type="button" class="rc-app-primary" data-action="new-release">+ New release</button>
              </div>

              <div class="rc-native-release-library" data-rc-native-release-library>
                <div class="rc-native-release-toolbar">
                  <div class="rc-native-release-filters" role="group" aria-label="Filter releases">
                    <button type="button" class="rc-native-filter" data-native-release-filter="ALL" data-active="true" aria-pressed="true">All</button>
                    <button type="button" class="rc-native-filter" data-native-release-filter="ACTIVE" aria-pressed="false">Active</button>
                    <button type="button" class="rc-native-filter" data-native-release-filter="CHANGES" aria-pressed="false">Needs changes</button>
                    <button type="button" class="rc-native-filter" data-native-release-filter="APPROVED" aria-pressed="false">Approved</button>
                    <button type="button" class="rc-native-filter" data-native-release-filter="LIVE" aria-pressed="false">Live</button>
                  </div>
                  <div class="rc-native-release-tools">
                    <label class="rc-native-release-search">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                      <input type="search" data-rc-native-release-search placeholder="Search releases" aria-label="Search releases">
                    </label>
                    <span data-rc-native-release-count>0 releases</span>
                  </div>
                </div>
                <div class="rc-native-release-grid" data-rc-native-release-grid></div>
              </div>

              <div class="rc-native-release-workspace" data-rc-native-release-workspace hidden></div>
            </section>

            <section class="rc-app-view" data-rc-view="profile" hidden>
              <div class="rc-app-page-head">
                <div>
                  <span class="rc-app-eyebrow">ReleaseCore identity</span>
                  <h1>Artist Profile</h1>
                  <p>One authoritative artist identity for releases, rights information and storefront experiences.</p>
                </div>
              </div>
              <div data-rc-native-profile></div>
            </section>

            <section class="rc-app-view" data-rc-view="contributors" hidden>
              <div class="rc-app-page-head">
                <div>
                  <span class="rc-app-eyebrow">ReleaseCore identities</span>
                  <h1>Contributors</h1>
                  <p>Reusable contributor identities linked to the selected artist and their release credits.</p>
                </div>
              </div>
              <div class="rc-app-contributors" data-rc-contributors></div>
            </section>
          </main>
        </div>

        <nav class="rc-app-mobile-nav" aria-label="Artist workspace">
          <button type="button" data-rc-nav="dashboard" data-active="true" aria-label="Dashboard">
            <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="4" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="14" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="14" width="6" height="6" rx="1.4" stroke="currentColor" stroke-width="1.7"/></svg>
            <span>Home</span>
          </button>
          <button type="button" data-rc-nav="releases" aria-label="My releases">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 18V5l10-2v13M9 9l10-2M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.7"/></svg>
            <span>Releases</span>
          </button>
          <button type="button" data-action="new-release" aria-label="New release"><span class="rc-app-mobile-nav__plus">+</span><span>New</span></button>
          <button type="button" data-rc-nav="profile" aria-label="Artist profile">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.7"/></svg>
            <span>Profile</span>
          </button>
          <button type="button" data-action="open-more" aria-label="More">
            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
            <span>More</span>
          </button>
        </nav>

        <div class="rc-app-more-backdrop" data-rc-more-backdrop hidden></div>
        <div class="rc-app-more-sheet" data-rc-more-sheet hidden>
          <div class="rc-app-more-sheet__head"><strong>More</strong><button type="button" data-action="close-more" aria-label="Close">✕</button></div>
          <button type="button" class="rc-app-nav" data-rc-nav="contributors"><span class="rc-app-nav__copy"><strong>Contributors</strong></span></button>
          {% if block.settings.supplemental_menu != blank %}
            {% for link in block.settings.supplemental_menu.links %}
              {% if link.links != blank %}
                <details class="rc-app-menu-group">
                  <summary class="rc-app-nav">
                    <span class="rc-app-nav__icon" aria-hidden="true">
                      {% render 'releasecore-menu-icon', title: link.title, auto_match: block.settings.supplemental_auto_icons, fallback: block.settings.supplemental_fallback_icon %}
                    </span>
                    <span class="rc-app-nav__copy"><strong>{{ link.title | escape }}</strong></span>
                    <svg class="rc-app-menu-group__chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </summary>
                  <div class="rc-app-menu-children">
                    {% if link.url != blank and link.url != '#' %}
                      <a class="rc-app-nav rc-app-menu-overview" href="{{ link.url }}"><span class="rc-app-nav__copy"><strong>Open {{ link.title | escape }}</strong></span></a>
                    {% endif %}
                    {% for child in link.links %}
                      {% if child.links != blank %}
                        <details class="rc-app-menu-group">
                          <summary class="rc-app-nav">
                            <span class="rc-app-nav__copy"><strong>{{ child.title | escape }}</strong></span>
                            <svg class="rc-app-menu-group__chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </summary>
                          <div class="rc-app-menu-children rc-app-menu-children--level-3">
                            {% if child.url != blank and child.url != '#' %}
                              <a class="rc-app-nav rc-app-menu-overview" href="{{ child.url }}"><span class="rc-app-nav__copy"><strong>Open {{ child.title | escape }}</strong></span></a>
                            {% endif %}
                            {% for grandchild in child.links %}
                              <a class="rc-app-nav" href="{{ grandchild.url }}"><span class="rc-app-nav__copy"><strong>{{ grandchild.title | escape }}</strong></span></a>
                            {% endfor %}
                          </div>
                        </details>
                      {% else %}
                        <a class="rc-app-nav" href="{{ child.url }}"><span class="rc-app-nav__copy"><strong>{{ child.title | escape }}</strong></span></a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </details>
              {% else %}
                <a class="rc-app-nav" href="{{ link.url }}">
                  <span class="rc-app-nav__icon" aria-hidden="true">
                    {% render 'releasecore-menu-icon', title: link.title, auto_match: block.settings.supplemental_auto_icons, fallback: block.settings.supplemental_fallback_icon %}
                  </span>
                  <span class="rc-app-nav__copy"><strong>{{ link.title | escape }}</strong></span>
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="rc-app-dashboard__shell">
      <div class="rc-app-membership-gate" style="display:block;">
        <span class="rc-app-eyebrow">RLIAB artist portal</span>
        <h2>Sign in to open your artist workspace.</h2>
        <p>Your RLIAB subscription and artist access are connected to your Shopify customer account.</p>
        <a class="rc-app-primary" style="display:inline-flex;align-items:center;text-decoration:none;" href="{{ routes.account_login_url }}">Sign in</a>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Artist dashboard",
  "target": "section",
  "stylesheet": "releasecore-dashboard.css",
  "javascript": "releasecore-dashboard.js",
  "settings": [
    {
      "type": "header",
      "content": "Artist header"
    },
    {
      "type": "checkbox",
      "id": "show_legal_name",
      "label": "Show legal name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pro",
      "label": "Show PRO",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ipi",
      "label": "Show IPI / CAE",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_publisher",
      "label": "Show publisher",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_publisher_ipi",
      "label": "Show publisher IPI",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_account_status",
      "label": "Show account status",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_membership",
      "label": "Show membership label",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "supplemental_menu",
      "label": "Additional dashboard menu",
      "info": "Choose a Shopify Navigation menu for Tools, Promote, Rights Management, Support or other merchant-owned dashboard pages. Nested Shopify menu levels are supported."
    },
    {
      "type": "checkbox",
      "id": "supplemental_auto_icons",
      "label": "Automatically match menu icons",
      "default": true,
      "info": "Uses menu titles to choose music-business icons for artwork, beat licensing, agreements, split sheets, promotion, rights, royalties, distribution, studio tools, blog, support and more."
    },
    {
      "type": "select",
      "id": "supplemental_fallback_icon",
      "label": "Fallback menu icon",
      "options": [
        { "value": "music", "label": "Music note" },
        { "value": "headphones", "label": "Headphones" },
        { "value": "sparkles", "label": "Sparkles" },
        { "value": "arrow", "label": "Arrow" }
      ],
      "default": "music",
      "info": "Used when a title does not match the automatic icon library, or for all items when automatic matching is disabled."
    },
    {
      "type": "text",
      "id": "supplemental_heading",
      "label": "Additional menu heading",
      "default": "East Rock"
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "ReleaseCore proxy path",
      "default": "/apps/releasecore"
    }
  ]
}
{% endschema %}
