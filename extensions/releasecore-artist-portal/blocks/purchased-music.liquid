<section
  class="rc-purchased"
  data-rc-purchased-music
  data-endpoint="{{ routes.root_url }}apps/releasecore/downloads"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-preview="{% if request.design_mode %}true{% else %}false{% endif %}"
  data-login-url="{{ routes.account_login_url }}"
  data-appearance="{{ block.settings.appearance }}"
  style="--rc-purchase-accent: {{ block.settings.accent_color }};"
  {{ block.shopify_attributes }}
>
  <div class="rc-purchased__shell">
    <header class="rc-purchased__header">
      <div>
        {% if block.settings.eyebrow != blank %}
          <span class="rc-purchased__eyebrow">{{ block.settings.eyebrow | escape }}</span>
        {% endif %}
        <h2>{{ block.settings.heading | escape }}</h2>
        {% if block.settings.description != blank %}
          <p>{{ block.settings.description | escape }}</p>
        {% endif %}
      </div>
    </header>

    <div data-rc-purchased-status class="rc-purchased__status" role="status" aria-live="polite">
      Loading purchased music…
    </div>
    <div data-rc-purchased-body></div>
  </div>
</section>

{% # theme-check-disable AssetSizeJavaScript %}
<script src="{{ 'releasecore-purchased-music.js' | asset_url }}" defer></script>
{% # theme-check-enable AssetSizeJavaScript %}

{% schema %}
{
  "name": "Purchased music",
  "target": "section",
  "stylesheet": "releasecore-purchased-music.css",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your library" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Purchased music" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Download the music you purchased from this store." },
    { "type": "select", "id": "appearance", "label": "Appearance", "default": "reactive", "options": [
      { "value": "reactive", "label": "Reactive / inherit theme" },
      { "value": "dark", "label": "Dark" },
      { "value": "light", "label": "Light" }
    ]},
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#8f7cff" }
  ]
}
{% endschema %}
