// ReleaseCore PostgreSQL schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Release {
  id                          String                 @id @default(cuid())
  shop                        String
  type                        String
  title                       String                 @default("Untitled Release")
  status                      String                 @default("DRAFT")
  distributionStatus          String                 @default("NOT_QUEUED")
  distributionUpdatedAt       DateTime?
  aggregatorReference         String?
  distributionNotes           String?
  upc                         String?                @unique
  upcAssignedAt               DateTime?
  catalogNumber               String?
  catalogNumberAssignedAt     DateTime?
  ownerCustomerId             String?
  shopifyReleaseProductId     String?                @unique
  shopifyReleaseProductHandle String?
  shopifyReleaseBundleOperationId String?
  artistName                  String? // legacy/display cache; normalized artists live in ReleaseArtist
  primaryGenre                String?
  releaseDate                 DateTime?
  availability                  String   @default("ALL_CURRENT_FUTURE")
  preOrderEnabled               Boolean  @default(false)
  preOrderDate                  DateTime?
  preOrderAudioPreviews         Boolean  @default(false)
  releaseTimeEnabled            Boolean  @default(false)
  releaseTime                   String?
  synchronousReleaseUnlocking   Boolean  @default(false)
  exclusiveEnabled              Boolean  @default(false)
  exclusivePartner              String?
  exclusivePeriodWeeks          Int?
  preSaveUrl                  String?
  streamingUrl                String?
  submittedAt                 DateTime?
  lastSubmittedAt             DateTime?
  reviewStartedAt             DateTime?
  decisionAt                  DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  tracks                      Track[]
  artists                     ReleaseArtist[]
  files                       ReleaseFile[]
  events                      SubmissionEvent[]
  notifications               NotificationDelivery[]
  reviewItems                 ReleaseReviewItem[]
  operationJobs              OperationJob[]

  @@unique([shop, catalogNumber])
  @@index([shop, status])
  @@index([shop, distributionStatus])
  @@index([shop, ownerCustomerId])
  @@index([shop, createdAt])
}

model Track {
  id                   String              @id @default(cuid())
  releaseId            String
  position             Int
  title                String              @default("Untitled Track")
  version              String?
  language             String?
  explicit             Boolean             @default(false)
  isrc                 String?             @unique
  isrcAssignedAt       DateTime?
  shopifyProductId     String?             @unique
  shopifyProductHandle String?
  lyrics               String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  release              Release             @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  artists              TrackArtist[]
  credits              TrackCredit[]
  files                ReleaseFile[]
  reviewItems          ReleaseReviewItem[]

  @@unique([releaseId, position])
  @@index([releaseId])
}

model Artist {
  id                 String                 @id @default(cuid())
  shop               String
  name               String
  legalName          String?
  email              String?
  spotifyUrl         String?
  appleMusicUrl      String?
  websiteUrl         String?
  imageUrl           String?
  imageFileId        String?
  shopifyCollectionId        String?   @unique
  shopifyCollectionHandle    String?
  shopifyCollectionSourceId  String?
  shopifyCollectionSyncedAt  DateTime?
  biography          String?
  pro                String?
  ipi                String?
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  youtubeUrl         String?
  xUrl               String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  releases           ReleaseArtist[]
  tracks             TrackArtist[]
  portalAccess       PortalArtistAccess[]
  soloPortalPolicies PortalCustomerPolicy[]
  contributors       ArtistContributor[]

  @@index([shop, name])
}

model ReleaseArtist {
  id        String   @id @default(cuid())
  releaseId String
  artistId  String
  role      String   @default("PRIMARY")
  position  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([releaseId, artistId, role])
  @@index([releaseId, position])
  @@index([artistId])
}

model TrackArtist {
  id        String   @id @default(cuid())
  trackId   String
  artistId  String
  role      String   @default("PRIMARY")
  position  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId, role])
  @@index([trackId, position])
  @@index([artistId])
}

model PortalArtistAccess {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  artistId   String
  role       String   @default("OWNER")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([shop, customerId, artistId])
  @@index([shop, customerId])
  @@index([artistId])
}

model PortalCustomerPolicy {
  id           String   @id @default(cuid())
  shop         String
  customerId   String
  artistMode   String   @default("MULTI")
  soloArtistId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  soloArtist   Artist?  @relation(fields: [soloArtistId], references: [id], onDelete: SetNull)

  @@unique([shop, customerId])
  @@index([soloArtistId])
}

model Contributor {
  id              String              @id @default(cuid())
  shop            String
  ownerCustomerId String?
  legalName       String
  stageName       String?
  email           String?
  pro             String?
  ipi             String?
  publisherName   String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  credits         TrackCredit[]
  artists         ArtistContributor[]

  @@index([shop, legalName])
  @@index([shop, ownerCustomerId])
}

model ArtistContributor {
  id            String      @id @default(cuid())
  artistId      String
  contributorId String
  createdAt     DateTime    @default(now())
  artist        Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([artistId, contributorId])
  @@index([artistId])
  @@index([contributorId])
}

model TrackCredit {
  id               String      @id @default(cuid())
  trackId          String
  contributorId    String
  role             String
  ownershipPercent Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  track            Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  contributor      Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([trackId, contributorId, role])
  @@index([trackId])
  @@index([contributorId])
}

model ReleaseFile {
  id              String   @id @default(cuid())
  releaseId       String
  trackId         String?
  kind            String
  filename        String
  storageProvider String   @default("SHOPIFY_FILES")
  storageKey      String?
  url             String?
  mimeType        String?
  sizeBytes       Int?
  status          String   @default("PENDING")
  derivativeFingerprint String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  release         Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track           Track?   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([trackId])
  @@index([trackId, kind])
}

model SubmissionEvent {
  id         String                 @id @default(cuid())
  releaseId  String
  type       String
  message    String?
  actorLabel String?
  fromStatus String?
  toStatus   String?
  trackId    String?
  createdAt  DateTime               @default(now())
  release    Release                @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([releaseId, createdAt])
}

model NotificationDelivery {
  id         String          @id @default(cuid())
  shop       String
  releaseId  String
  eventId    String
  channel    String
  recipient  String?
  status     String          @default("PENDING")
  attempts   Int             @default(0)
  providerId String?
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  release    Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  event      SubmissionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, channel])
  @@index([shop, createdAt])
  @@index([releaseId, createdAt])
  @@index([status])
}

model ReleaseReviewItem {
  id         String    @id @default(cuid())
  releaseId  String
  trackId    String?
  message    String
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  release    Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track      Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([releaseId, status])
  @@index([trackId])
}

model OperationJob {
  id                String                @id @default(cuid())
  shop              String
  deploymentProfile String                @default("releasecore")
  releaseId         String?
  intent            String
  status            String                @default("QUEUED")
  fingerprint       String
  idempotencyKey    String
  payload           Json
  result            Json?
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(3)
  availableAt       DateTime              @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  startedAt         DateTime?
  completedAt       DateTime?
  lastError         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  release           Release?              @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  attemptLog        OperationJobAttempt[]

  @@unique([shop, idempotencyKey])
  @@index([deploymentProfile, status, availableAt])
  @@index([shop, releaseId, createdAt])
  @@index([shop, status, updatedAt])
}

model OperationJobAttempt {
  id          String       @id @default(cuid())
  jobId       String
  attempt     Int
  status      String       @default("RUNNING")
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  error       String?
  result      Json?
  job         OperationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([jobId, startedAt])
}

model AppSettings {
  id                                     String  @id @default(cuid())
  shop                                   String  @unique
  countryCode                            String?
  registrantCode                         String?
  isrcMode                               String  @default("AUTO")
  autoAssignIsrc                         Boolean @default(true)
  defaultLabelName                       String?
  defaultCopyrightHolder                 String?
  defaultGenre                           String?
  defaultLanguage                        String?
  requireLyrics                          Boolean @default(true)
  requirePublishing                      Boolean @default(true)
  requireSplitSheet                      Boolean @default(false)
  requireCredits                         Boolean @default(false)
  requireIsrc                            Boolean @default(true)
  requireTrackLanguage                   Boolean @default(true)
  releaseLeadTimeEnabled                 Boolean @default(false)
  releaseLeadTimeDays                    Int     @default(14)
  upcMode                                String  @default("AGGREGATOR")
  gs1CompanyPrefix                       String?
  catalogMode                            String  @default("AUTO")
  catalogPrefix                          String?
  catalogIncludeYear                     Boolean @default(true)
  catalogSequenceWidth                   Int     @default(4)
  autoAssignCatalogNumber                Boolean @default(true)
  defaultTrackPrice                      Float   @default(1.29)
  defaultAlbumPrice                      Float   @default(9.99)
  shopifyTrackProductDefaultState        String  @default("DRAFT")
  shopifyAlbumProductDefaultState        String  @default("DRAFT")
  shopifySingleTemplateSuffix            String?
  shopifyAlbumTemplateSuffix             String?
  shopifyArtistCollectionTemplateSuffix  String?
  customerDownloadsEnabled                 Boolean @default(true)
  customerDownloadAutoGenerate             Boolean @default(true)
  customerDownloadMp3Enabled               Boolean @default(true)
  customerDownloadMp3BitrateKbps           Int     @default(320)
  customerDownloadFlacEnabled              Boolean @default(true)
  customerDownloadFlacCompressionLevel     Int     @default(5)
  customerDownloadEmbedArtwork             Boolean @default(true)
  customerDownloadEmbedLyrics              Boolean @default(true)
  customerDownloadEmbedCredits             Boolean @default(true)
  customerDownloadEmbedArtistLinks         Boolean @default(true)

  generateShopifyAudioPreview            Boolean @default(false)
  audioPreviewDurationSeconds            Int     @default(60)
  audioPreviewBitrateKbps                Int     @default(192)
  lockArtistNameEditing                  Boolean @default(true)
  lockContributorIdentityAfterSubmission Boolean @default(true)

  // Storefront release creation access controls. Required tags are comma-separated.
  releaseSingleEnabled      Boolean @default(true)
  releaseSingleRequiredTags String?
  releaseEpEnabled          Boolean @default(true)
  releaseEpRequiredTags     String?
  releaseAlbumEnabled       Boolean @default(true)
  releaseAlbumRequiredTags  String?
  releaseTagMatchMode       String  @default("ANY")
  releaseAccessLockMessage  String?

  // Automation / communications. Event lists are comma-separated ReleaseCore event keys.
  artistEmailEvents     String  @default("SUBMITTED,CHANGES_REQUESTED,APPROVED,REJECTED,SUBMITTED_TO_STORES,DELIVERED")
  adminEmailEvents      String  @default("SUBMITTED,CHANGES_REQUESTED,APPROVED,REJECTED")
  flowEvents            String  @default("SUBMITTED,CHANGES_REQUESTED,APPROVED,REJECTED,PROCESSING,SUBMITTED_TO_STORES,DELIVERED,SHOPIFY_PRODUCTS_SYNCED")
  // Merchant-owned SMTP delivery. Password is encrypted at rest by ReleaseCore.
  smtpEnabled           Boolean @default(false)
  smtpHost              String?
  smtpPort              Int     @default(587)
  smtpSecurity          String  @default("STARTTLS")
  smtpUsername          String?
  smtpPasswordEncrypted String?

  emailSenderName        String?
  emailFromAddress       String?
  emailReplyTo           String?
  adminNotificationEmail String?
  emailBrandName         String?
  emailFooterText        String?
  portalUrl              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IsrcSequence {
  id              String   @id @default(cuid())
  shop            String
  countryCode     String
  registrantCode  String
  year            Int
  nextDesignation Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, countryCode, registrantCode, year])
  @@index([shop, year])
}

model UpcSequence {
  id                String   @id @default(cuid())
  shop              String
  companyPrefix     String
  nextItemReference Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, companyPrefix])
  @@index([shop])
}

model CatalogSequence {
  id           String   @id @default(cuid())
  shop         String
  prefix       String
  yearKey      Int
  nextSequence Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, prefix, yearKey])
  @@index([shop, yearKey])
}

model PrivacyRequest {
  id               String    @id @default(cuid())
  shop             String
  topic            String
  shopifyRequestId String
  customerId       String?
  customerEmail    String?
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  lastError        String?
  requestedAt      DateTime  @default(now())
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, topic, shopifyRequestId])
  @@index([shop, status, requestedAt])
  @@index([shop, customerId])
}

model CommerceOrder {
  id              String   @id @default(cuid())
  shop            String
  shopifyOrderId  String
  shopifyOrderGid String?
  orderName       String?
  customerId      String?
  currency        String?
  status          String   @default("PAID")
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entitlements CommerceEntitlement[]

  @@unique([shop, shopifyOrderId])
  @@index([shop, customerId])
  @@index([shop, createdAt])
}

model CommerceEntitlement {
  id                   String   @id @default(cuid())
  shop                 String
  commerceOrderId      String
  shopifyOrderId       String
  shopifyLineItemId    String
  salesLineItemGroupId String?
  customerId           String?
  trackId              String
  releaseId            String
  sourceProductId      String?
  sourceKind           String   @default("TRACK")
  quantity             Int      @default(1)
  refundedQuantity     Int      @default(0)
  status               String   @default("ACTIVE")
  revokedAt            DateTime?
  revokeReason         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order     CommerceOrder      @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)
  downloads CommerceDownload[]

  @@unique([shop, shopifyOrderId, shopifyLineItemId, trackId])
  @@index([shop, customerId, status])
  @@index([shop, shopifyOrderId, status])
  @@index([shop, trackId])
}

model CommerceDownload {
  id            String   @id @default(cuid())
  shop          String
  entitlementId String
  customerId    String?
  format        String?
  releaseFileId String?
  downloadedAt  DateTime @default(now())

  entitlement CommerceEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([shop, entitlementId])
  @@index([shop, customerId])
}

model CommerceWebhookEvent {
  id          String   @id @default(cuid())
  shop        String
  topic       String
  resourceId  String
  processedAt DateTime @default(now())

  @@unique([shop, topic, resourceId])
}
